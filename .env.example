# Copy this file to .env and fill in your values

# MongoDB (local or Atlas connection string)
MONGODB_URI=

# JWT Secret (generate a random string)
JWT_SECRET=
JWT_EXPIRE=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (optional) — used for password-reset emails.
# Leave SMTP_HOST blank in development to log reset links to the server console instead of sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server
PORT=
NODE_ENV=
CLIENT_URL=
